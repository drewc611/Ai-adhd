  "repository": {
    "url": "https://github.com/drewc611/Ai-adhd",
    "source": "github"
  },
  "version": "0.0.1",
  "websiteUrl": "https://github.com/drewc611/Ai-adhd#readme",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "ai-adhd",
      "version": "0.0.1",
      "transport": {
        "type": "stdio"
      },
      "runtimeHint": "npx",
      "runtimeArguments": [
        {
          "type": "positional",
          "value": "ai-adhd",
          "valueHint": "package",
          "isRequired": true
        }
      ]
    }
  ]
}
