{
  "name": "adhd",
  "version": "0.0.1",
  "description": "Anchoring Defeat by Heterogeneous Divergence. Compiler, validator, scorer, and eval harness for a subagent reasoning architecture. Never calls a model.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "adhd": "dist/cli.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist/src",
    "config",
    "prompts",
    "docs",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/test/*.test.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "adhd": "node dist/cli.js",
    "mcp": "node dist/mcp.js",
    "prepublishOnly": "npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "commander": "^13.1.0",
    "yaml": "^2.9.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/drewc611/Ai-adhd.git"
  },
  "homepage": "https://github.com/drewc611/Ai-adhd#readme",
  "bugs": {
    "url": "https://github.com/drewc611/Ai-adhd/issues"
  },
  "keywords": [
    "reasoning",
    "divergence",
    "subagents",
    "critic",
    "claude-code",
    "mcp"
  ],
  "publishConfig": {
    "access": "public"
  }
}
